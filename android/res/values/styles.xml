<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Material theme: native dialogs/pickers spawned by the app
         (file chooser, <select> lists) match the light in-app UI. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/vp_surface</item>
        <item name="android:navigationBarColor">@color/vp_nav</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/vp_primary</item>
        <item name="android:colorAccent">@color/vp_primary</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
